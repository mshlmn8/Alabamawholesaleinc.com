{
  "name": "alabama-wholesale",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Alabama Wholesale Inc — wholesale retail catalog website",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "seed": "node scripts/build-seed.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run images",
    "build": "vite build && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/check-migrations.mjs --seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  }
}
